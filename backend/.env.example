# Copy to .env and adjust. Loaded by the Nix dev shell / justfile (set dotenv-load).

# Connection string Prisma uses to reach the Postgres container.
# Matches the `db` service credentials in the root docker-compose.yml.
DATABASE_URL="postgresql://todo:todo@localhost:5432/todo?schema=public"

# Base URL of the auth service, used to resolve collaborator names.
# In the compose stack it is set on the `backend` service.
AUTH_SERVICE_URL="http://localhost:4000"
