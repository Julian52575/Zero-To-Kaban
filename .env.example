# Copy to .env and adjust. Loaded by the Nix dev shell and by every `just`
# recipe (`set dotenv-load`). Keep secrets out of git -- .env is ignored.

# Host ports the Traefik proxy publishes: HTTP entrypoint and dashboard.
PROXY_PORT=8000
PROXY_DASHBOARD_PORT=8080

# Postgres credentials for the APP database 
# (`db` service + the backend's DATABASE_URL).
# See backend/.env.example for non-Docker use.
POSTGRES_USER=todo_nbjkvlfddsfiuojkvb
POSTGRES_PASSWORD=todo_khvjgyguihouj9pjlhnkujb
POSTGRES_DB=todo

RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password
RABBITMQ_PORT=5672

# Postgres credentials for the AUTH database
# (`authdb` service + the auth service's DATABASE_URL).
AUTH_POSTGRES_USER=auth_ihgvkjwrtoiuhsdfg
AUTH_POSTGRES_PASSWORD=auth_p9k3jhrg0w9eukjhf
AUTH_POSTGRES_DB=auth

# Secret the `auth` service uses to sign session cookies (JWT, HS256).
# Generate a real one with: openssl rand -hex 32
SESSION_SECRET=change-me-run-openssl-rand-hex-32

# Set to "true" once the proxy terminates HTTPS,
# so the session cookie gets the Secure attribute.
# Leave "false" for plain-HTTP local dev.
COOKIE_SECURE=false

# Override where rootless Podman keeps its image/container storage.
# Leave unset to use ./.containers -- or, when the project lives on a
# network/virtualised filesystem (e.g. WSL2 drvfs), an auto-picked path
# under $HOME (~/.cache/podman-storage/<project>).
# PODMAN_STORAGE_DIR=/home/you/.cache/podman-storage/myproject

# Set to 1 to stop the dev shell from starting a Podman API socket
# (useful in CI or headless environments).
# PODMAN_NO_SOCKET=1
