# Copy to .env for local, non-container use (`npm run dev`). In the compose
# stack these values come from the root docker-compose.yml / root .env instead.

# Postgres connection for the login service's OWN database, with its OWN
# credentials -- deliberately different from the app DB (POSTGRES_* in the root
# .env). In the compose stack these come from AUTH_POSTGRES_* on the `authdb`
# service; for bare `npm run dev` start a local Postgres and adjust host/port.
DATABASE_URL="postgresql://auth_ihgvkjwrtoiuhsdfg:auth_p9k3jhrg0w9eukjhf@localhost:5432/auth?schema=public"

# Secret used to sign session cookies (JWT, HS256). REQUIRED -- the service
# exits on boot if it is missing. Generate a real one with:
#   openssl rand -hex 32
SESSION_SECRET="dev-only-not-a-real-secret-change-me"

# Optional overrides (defaults shown).
# PORT=4000
# SESSION_TTL_SECONDS=604800          # 7 days
# SESSION_COOKIE_NAME=session
# COOKIE_SECURE=false                 # "true" once the proxy terminates HTTPS
# VERIFY_CACHE_TTL_MS=5000            # token-version cache used by /internal/verify
